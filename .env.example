# --- LLM (OpenAI-compatible) ---
# Required only for `ask` / the Streamlit UI. Retrieval + eval metrics work without it.
OPENAI_API_KEY=sk-your-key-here
# Point at any OpenAI-compatible endpoint (Ollama, vLLM, Together, ...).
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Embeddings ---
# "local" (default) uses sentence-transformers; "openai" uses the embeddings API.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Required only when EMBEDDING_PROVIDER=openai.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Ingestion / chunking ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50
CHUNK_STRATEGY=fixed        # "fixed" or "paragraph"

# --- Retrieval ---
TOP_K=5
# "dense" (default, FAISS cosine) | "bm25" (keyword, no embeddings) | "hybrid" (both, fused)
RETRIEVAL_STRATEGY=dense
# Dense weight in hybrid fusion: 0 = pure BM25, 1 = pure dense. Tuned to 0.4 on the golden set.
HYBRID_ALPHA=0.4

# --- Reranking (cross-encoder, off by default) ---
# Set to true to rerank the first-stage candidate pool with a cross-encoder.
# Download happens once (~80 MB) and is cached; CLI flag: --rerank.
RERANK=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANK_CANDIDATES=20
